# Provider selection by role.
# Default mix preserves the current repo behavior:
# - generation uses watsonx
# - evaluation uses Azure OpenAI
# - embeddings use Azure OpenAI
# Note: evaluation currently requires an OpenAI-compatible backend for RAGAS
# collection metrics, so EVALUATION_PROVIDER must be azure_openai or openai.
GENERATION_PROVIDER=watsonx
EVALUATION_PROVIDER=azure_openai
EMBEDDING_PROVIDER=azure_openai

# Optional role-specific model overrides.
# Fallback behavior when left empty:
# - watsonx generation -> WATSONX_MODEL_ID
# - watsonx embeddings -> WATSONX_EMBEDDING_MODEL_ID
# - azure_openai generation/evaluation -> AZURE_OPENAI_DEPLOYMENT_NAME
# - azure_openai embeddings -> AZURE_OPENAI_EMBEDDING_DEPLOYMENT
# - openai requires the explicit role model env for each selected role
# - watsonx is valid for generation and embeddings, but not for evaluation in
#   this project
GENERATION_MODEL=
EVALUATION_MODEL=
EMBEDDING_MODEL=

# Azure OpenAI credentials and deployments.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Plain OpenAI credentials.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# IBM watsonx credentials and models.
WATSONX_APIKEY=
WATSONX_URL=
WATSONX_PROJECT_ID=
WATSONX_MODEL_ID=meta-llama/llama-3-3-70b-instruct
WATSONX_EMBEDDING_MODEL_ID=
